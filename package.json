{
  "name": "ltvstudio-web-api",
  "version": "1.0.0",
  "description": "LTVStudio License Verification & Version Update Management Web API (TypeScript)",
  "scripts": {
    "start": "tsx server.ts",
    "dev": "tsx watch server.ts",
    "dev:ui": "vite",
