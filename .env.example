# ========================================================
# LTVStudio Web API & License Server - Environment Variables
# ========================================================

# 1. Mã bí mật dành cho Quản trị viên (SuperAdmin)
# Mặc định: ltvstudio_secret_admin_2026 (Khuyên đổi trên môi trường Production)
ADMIN_SECRET=ltvstudio_secret_admin_2026

# 2. Khóa bảo mật ký Session Token & Chữ ký số HMAC
# Tùy chọn (Nếu bỏ trống sẽ tự động sinh dựa trên ADMIN_SECRET)
AUTH_TOKEN_SECRET=ltvstudio_secret_admin_2026_ltv_signature_secret_2026
AUTH_TOKEN_TTL_SECONDS=86400

# 3. Mã bí mật phân quyền phụ (RBAC - Tùy chọn)
SUPPORT_SECRET=ltvstudio_support_2026
AUDITOR_SECRET=ltvstudio_auditor_2026

# ========================================================
# 🐘 4. NEON POSTGRES DATABASE (Serverless Postgres Cloud)
# Đăng ký miễn phí tại https://neon.tech
# Tạo database mới -> Sao chép Connection String và dán vào đây:
# ========================================================
DATABASE_URL=postgresql://neondb_owner:npg_xxxx@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# (Tùy chọn: Tương thích Vercel Postgres Integration)
# POSTGRES_URL=postgresql://...
# NEON_DATABASE_URL=postgresql://...

# ========================================================
# 5. Cấu hình máy chủ cục bộ (Local Server)
# ========================================================
PORT=8080
